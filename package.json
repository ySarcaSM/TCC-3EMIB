    "@ionic/react-router": "^8.0.0",
    "ionicons": "^7.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
